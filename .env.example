# PostgreSQL Database URL (pooled connection for Vercel Serverless / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/zeekr_db?pgbouncer=true"

# Direct URL for Prisma Migrations (optional if using connection pooler)
DIRECT_URL="postgresql://user:password@host:5432/zeekr_db"

# JWT Secret for Admin Auth
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret"

# Telegram Bot Integration for Lead Notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="-1001234567890"

# Optional Cloudinary / Vercel Blob for image uploads
BLOB_READ_WRITE_TOKEN=""

